{
  "name": "@ordernow/capacitor-language",
  "version": "1.0.0",
  "description": "Set the iOS per-app language (Settings → App → Language) from Capacitor apps",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "files": [
    "dist/",
    "ios/Sources",
    "Package.swift",
    "OrdernowCapacitorLanguage.podspec",
    "LICENSE"
  ],
  "author": "MinhVDV",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark-ordernow/capacitor-language.git"
  },
  "bugs": {
    "url": "https://github.com/mark-ordernow/capacitor-language/issues"
  },
  "funding": {
    "type": "paypal",
    "url": "https://paypal.me/MinhVDV"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "language",
    "locale",
    "i18n"
  ],
  "scripts": {
    "verify": "npm run verify:ios && npm run verify:web",
    "verify:ios": "xcodebuild -scheme OrdernowCapacitorLanguage -destination generic/platform=iOS",
    "verify:web": "npm run build",
    "lint": "npm run eslint && npm run prettier -- --check && npm run swiftlint -- lint",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write && npm run swiftlint -- --fix --format",
    "eslint": "eslint . --ext ts",
    "prettier": "prettier \"**/*.{css,html,ts,js}\"",
    "swiftlint": "node-swiftlint",
    "docgen": "docgen --api AppLanguagePlugin --output-readme README.md --output-json dist/docs.json",
    "build": "npm run clean && npm run docgen && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@capacitor/core": "^7.4.4",
    "@capacitor/docgen": "^0.3.1",
    "@capacitor/ios": "^7.4.4",
    "@ionic/eslint-config": "^0.4.0",
    "@ionic/prettier-config": "^4.0.0",
    "@ionic/swiftlint-config": "^2.0.0",
    "eslint": "^8.57.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.0",
    "rollup": "^4.53.2",
    "swiftlint": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@capacitor/core": ">=6.0.0 <9.0.0"
  },
  "prettier": "@ionic/prettier-config",
  "swiftlint": "@ionic/swiftlint-config",
  "eslintConfig": {
    "extends": "@ionic/eslint-config/recommended"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    }
  },
  "homepage": "https://github.com/mark-ordernow/capacitor-language#readme"
}
